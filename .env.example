# Copy to .env and fill in. Every value below is a credential or a commitment:
# none of them may be committed, pasted into an issue, or sent over an
# unencrypted channel.
#
# The application checks all of this at startup and refuses to serve a
# production build that is misconfigured. See src/lib/preflight.ts.


# --- The master key ---------------------------------------------------------
# Seals everything held encrypted at rest: second-factor secrets and sealed
# field values. Generate it once, put it in a secret store, and back it up
# somewhere the database backup is not.
#
#   openssl rand -base64 48
#
# READ THIS BEFORE YOU SET IT:
#   - Losing this key loses every sealed value irrecoverably. The ciphertext
#     survives in the database and is worthless without it.
#   - Changing it has exactly the same effect as losing it. There is no
#     re-wrapping on read; a value sealed under the old key will not open.
#   - It does NOT protect officer signing keys. Those are sealed under each
#     officer's own passphrase, which the server never learns, so this key
#     being stolen still yields no ability to sign in an officer's name.
#
# In development it may be left unset — an ephemeral key is generated and
# everything sealed under it is lost at restart, which is the intended nuisance.
APEX_MASTER_KEY=""


# --- The register ------------------------------------------------------------
# SQLite for a single-office deployment. The path is relative to prisma/.
DATABASE_URL="file:../data/ledger.db"

# For a hosted deployment, switch prisma/schema.prisma's datasource provider to
# "postgresql" and set a connection string instead. Keep sslmode: member data
# and sealed material cross this connection.
# DATABASE_URL="postgresql://user:password@host:5432/apex?sslmode=require"


# --- The evidence store -------------------------------------------------------
# Where uploaded evidence and attachments are written, content-addressed by
# SHA-256. Back this directory up TOGETHER WITH the database — the database
# without it proves nothing, and it without the database is a pile of files
# named after their own hashes.
STORAGE_DIR="./storage"


# --- Public identity ----------------------------------------------------------
# The origin printed on certified extracts and credentials, and the address a
# recipient visits to verify one. Behind a proxy this cannot be derived from the
# request, and a printed certificate carrying "localhost:3000" is worthless.
# No trailing slash, no path.
# APEX_PUBLIC_ORIGIN="https://registry.apexkingdom.example"

# --- Identity verification (optional) ---------------------------------------
# Didit runs the document check, the liveness check and the face match. The
# register receives only the verdict — never a document image, a portrait, or a
# biometric template. Free tier: 500 checks a month.
#
# Get the key from the Didit console. NEVER commit a populated .env.
DIDIT_API_KEY=
# The per-destination secret from the Didit webhook console. Without it the
# webhook endpoint fails closed and refuses every request, which is correct but
# means results never arrive.
DIDIT_WEBHOOK_SECRET=
