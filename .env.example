# Copy to .env and fill in. Both values below are credentials: they must never
# be committed, pasted into an issue, or shared over an unencrypted channel.

# SQLite for a single-office deployment. The path is relative to prisma/.
DATABASE_URL="file:../data/ledger.db"

# For a hosted deployment, switch prisma/schema.prisma's datasource provider to
# "postgresql" and set a connection string instead:
# DATABASE_URL="postgresql://user:password@host:5432/apex?sslmode=require"

# Where uploaded evidence and attachments are written. Back this directory up
# together with the database — one without the other proves nothing.
STORAGE_DIR="./storage"
